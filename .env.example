# Freeroute Configuration (All fields optional - defaults work out of the box)
# Database automatically resolves to ~/.freeroute/freeroute.db
# Master encryption key automatically resolves to ~/.freeroute/master.key

PORT=20129
# Optional: Override database location
# DATABASE_URL="file:~/.freeroute/freeroute.db"

# --- Security -----------------------------------------------------------------
# Bind address. Loopback by default: the dashboard and admin API have no login,
# so the security boundary is that the server is unreachable from the network.
# Set to 0.0.0.0 only together with FREEROUTE_ADMIN_TOKEN.
# HOST=127.0.0.1

# Optional. When set, admin/dashboard API routes require either a loopback
# connection or `Authorization: Bearer <token>`. Needed to reach the dashboard
# from another machine.
# FREEROUTE_ADMIN_TOKEN=

# Set to 1 to require FREEROUTE_ADMIN_TOKEN on every admin request, including
# from localhost — use this when several people share the machine.
# FREEROUTE_REQUIRE_ADMIN=1
